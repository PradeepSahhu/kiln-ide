{
  "name": "kiln-ide",
  "productName": "Kiln IDE",
  "version": "0.1.0",
  "description": "A Rider-style IDE for C#/.NET, Python and Agentic AI projects with auto-build, Git and Claude built in.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=4 \"test/unit/*.test.js\"",
    "test:e2e": "KILN_E2E=1 node --test --test-concurrency=1 --test-timeout=3600000 \"test/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:e2e",
    "postinstall": "node scripts/postinstall.js",
    "dist": "electron-builder --mac --arm64",
    "dist:dir": "electron-builder --mac --arm64 --dir"
  },
  "author": "Pradeep Sahu",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "htm": "^3.1.1",
    "kafkajs": "^2.2.4",
    "marked": "^18.1.1",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "preact": "^10.29.8",
    "pyright": "^1.1.414",
    "smol-toml": "^1.9.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1"
  },
  "build": {
    "appId": "dev.kiln.ide",
    "productName": "Kiln IDE",
    "copyright": "Copyright © 2026 Pradeep Sahu",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "src/**/*",
      "resources/**/*",
      "!**/.DS_Store",
      "!test/**",
      "!docs/**",
      "!scripts/**"
    ],
    "asar": true,
    "asarUnpack": [
      "src/agent-tools/**",
      "src/main/services/codeindex/**",
      "src/main/services/refactor/**",
      "node_modules/typescript/**",
      "resources/**",
      "node_modules/node-pty/**",
      "node_modules/@vscode/tree-sitter-wasm/**",
      "node_modules/pyright/**",
      "node_modules/@anthropic-ai/claude-agent-sdk/**",
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Kiln IDE"
    }
  }
}
