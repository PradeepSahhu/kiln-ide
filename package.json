{
  "name": "kiln-ide",
  "productName": "Kiln IDE",
  "version": "0.1.0",
  "description": "A Rider-style IDE for C#/.NET, Python and Agentic AI projects with auto-build, Git and Claude built in.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=4 \"test/unit/*.test.js\"",
    "test:e2e": "KILN_E2E=1 node --test --test-concurrency=1 --test-timeout=3600000 \"test/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:e2e",
    "postinstall": "node scripts/postinstall.js"
  },
  "author": "Pradeep Sahu",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "htm": "^3.1.1",
    "kafkajs": "^2.2.4",
    "marked": "^18.1.1",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "preact": "^10.29.8",
    "pyright": "^1.1.414",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.0.0",
    "playwright-core": "^1.64.1"
  }
}
